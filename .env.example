# --- Core Django -------------------------------------------------
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# --- Postgres (only read when DEBUG=False) ------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# --- Email (required — settings.py has no default for these) ------
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM_ADDRESS=

# --- Stripe (leave blank to disable payments) ----------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- ID prefixes (settings.py already defaults these, override if needed) --
STUDENT_ID_PREFIX=
LECTURER_ID_PREFIX=
ORG_ADMIN_ID_PREFIX=

# --- Gunicorn tuning ------------------------------------------------
GUNICORN_WORKERS=
GUNICORN_TIMEOUT=

# --- Optional: auto-create a superuser on first boot -----------------
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=